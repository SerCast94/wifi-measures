// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Seeder {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("seeders")
}

model Medida {
  id           String   @id @default(uuid())
  idLinkLive   String   @unique
  name         String?
  fechaHora    DateTime?
  lat          Float?
  lon          Float?
  areaGeogr    String?
  provincia    String?
  emisiones    String?
  ptoMedida    String?
  nMedida      Int      @default(0)
  azimut       Int      @default(0)
  resultType   String?
  unitName     String?
  unitMac      String?
  unitType     String?
  profileName  String?
  overallColor String?
  labels       String[]
  raw          Json?
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("medidas")
}

model AreaPlan {
  id        Int      @id @default(autoincrement())
  areaId    Int      @unique
  name      String
  image     String
  width     Int
  height    Int
  positions Json?
  heatmap   Json?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("area_plans")
}

model LinkLiveSurvey {
  id                    Int                 @id @default(autoincrement())
  idLinkLive            String              @unique
  name                  String?
  surveyName            String?
  surveyDescription     String?
  surveyMode            String?
  surveyPointCount      Int                 @default(0)
  surveyBluetooth       Boolean             @default(false)
  surveyActive1x1       Boolean             @default(false)
  ssid1x1               String?
  unitId                String?
  unitName              String?
  unitMac               String?
  unitSerial            String?
  unitType              String?
  unitHardware          String?
  status                String?
  fileType              String?
  floorPlanFilename     String?
  floorPlanWidth        Int                 @default(0)
  floorPlanHeight       Int                 @default(0)
  floorPlanScalePpf     Float               @default(0)
  floorPlanScaledWidth  Int                 @default(0)
  floorPlanScaledHeight Int                 @default(0)
  analysisGuid          String?
  surveyStartTime       DateTime?
  image                 String?
  points                LinkLiveSurveyPoint[]
  createdAt             DateTime            @default(now()) @map("created_at")
  updatedAt             DateTime            @updatedAt @map("updated_at")

  @@map("linklive_surveys")
}

model LinkLiveSurveyPoint {
  id        Int             @id @default(autoincrement())
  surveyId  Int
  metric    String
  pointIdx  Int             @default(0)
  x         Float
  y         Float
  value     Float?
  time      String?
  survey    LinkLiveSurvey  @relation(fields: [surveyId], references: [id], onDelete: Cascade)

  @@index([surveyId])
  @@map("linklive_survey_points")
}

model LinkLiveAnalysis {
  id                   Int                     @id @default(autoincrement())
  idLinkLive           String                  @unique
  guid                 String?
  analysisGuid         String?
  analysisType         String?
  name                 String?
  status               String?
  startTime            DateTime?
  endTime              DateTime?
  fileName             String?
  unitId               String?
  unitName             String?
  unitType             String?
  unitHardware         String?
  apsCount             Int                     @default(0)
  bssidsCount          Int                     @default(0)
  ssidsCount           Int                     @default(0)
  clientsCount         Int                     @default(0)
  channelsCount        Int                     @default(0)
  probingClientsCount  Int                     @default(0)
  bluetoothCount       Int                     @default(0)
  href                 String?
  raw                  Json?
  hosts                LinkLiveAnalysisHost[]
  createdAt            DateTime                @default(now()) @map("created_at")
  updatedAt            DateTime                @default(now()) @updatedAt @map("updated_at")

  @@map("linklive_analyses")
}

model LinkLiveAnalysisHost {
  id           Int               @id @default(autoincrement())
  analysisId   Int
  hostType     String
  hostKey      String
  name         String?
  mac          String?
  channel      String?
  band         String?
  signal       Float?
  snr          Float?
  ssid         String?
  securityType String?
  protocol     String?
  inactive     Boolean           @default(false)
  lastSeen     DateTime?
  counts       Json?
  wifiItem     Json?
  raw          Json?
  analysis     LinkLiveAnalysis  @relation(fields: [analysisId], references: [id], onDelete: Cascade)
  createdAt    DateTime          @default(now()) @map("created_at")
  updatedAt    DateTime          @default(now()) @updatedAt @map("updated_at")

  @@unique([analysisId, hostType, hostKey])
  @@index([analysisId])
  @@map("linklive_analysis_hosts")
}

model User {
  id                    String           @id @default(uuid())
  name                  String
  username              String           @unique
  email                 String           @unique
  image                 String?
  password              String?
  active                Boolean          @default(true)
  createdAt             DateTime         @default(now()) @map("created_at")
  updatedAt             DateTime         @updatedAt @map("updated_at")
  permissionsAssignedBy RolePermission[] @relation("AssignedByUser")
  rolesAssignedBy       UserRole[]       @relation("AssignedByUser")
  roles                 UserRole[]       @relation("UserRole")

  @@map("users")
}

model Role {
  id          String           @id @default(uuid())
  name        String           @unique @db.VarChar(100)
  label       String?          @db.VarChar(100)
  description String?          @db.VarChar(300)
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")
  permissions RolePermission[]
  users       UserRole[]

  @@map("roles")
}

model Permission {
  id          String           @id @default(uuid())
  name        String           @unique @db.VarChar(100)
  label       String?          @db.VarChar(100)
  description String?          @db.VarChar(300)
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")
  roles       RolePermission[]

  @@map("permissions")
}

model UserRole {
  userId       String
  roleId       String
  assignedById String?  @map("assigned_by_id")
  assignedByAt DateTime @default(now()) @map("assigned_by_at")
  assignedBy   User?    @relation("AssignedByUser", fields: [assignedById], references: [id], onDelete: NoAction)
  role         Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  user         User     @relation("UserRole", fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@unique([userId, roleId])
  @@map("user_roles")
}

model RolePermission {
  roleId       String     @map("role_id")
  permissionId String     @map("permission_id")
  assignedById String?    @map("assigned_by_id")
  assignedByAt DateTime   @default(now()) @map("assigned_by_at")
  assignedBy   User?      @relation("AssignedByUser", fields: [assignedById], references: [id], onDelete: NoAction)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@unique([roleId, permissionId])
  @@map("role_permissions")
}

