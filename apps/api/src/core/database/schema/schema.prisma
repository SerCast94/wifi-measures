  c4Mhz     Decimal? @map("c4_mhz") @db.Decimal(20, 0)
  nivelC4   Decimal? @map("nivel_c4") @db.Decimal(20, 2)
  cNC4      Decimal? @map("c_n_c4") @db.Decimal(20, 2)
  cberC4    Decimal? @map("cber_c4") @db.Decimal(20, 6)
  vberC4    Decimal? @map("vber_c4") @db.Decimal(20, 8)
  merC4     Decimal? @map("mer_c4") @db.Decimal(20, 2)
  okC4      String?  @map("ok_c4") @db.VarChar(5)

  // Canal C5
  c5Servici String?  @map("c5_servici") @db.VarChar(4)
  c5        Int?     @map("c5")
  c5Mhz     Decimal? @map("c5_mhz") @db.Decimal(20, 0)
  nivelC5   Decimal? @map("nivel_c5") @db.Decimal(20, 2)
  cNC5      Decimal? @map("c_n_c5") @db.Decimal(20, 2)
  cberC5    Decimal? @map("cber_c5") @db.Decimal(20, 6)
  vberC5    Decimal? @map("vber_c5") @db.Decimal(20, 8)
