  merC8     Decimal? @map("mer_c8") @db.Decimal(20, 2)
  okC8      String?  @map("ok_c8") @db.VarChar(5)

  monitorizacion String? @map("monitorizacion") @db.VarChar(1)
  obsGenerales   String? @map("obs_generales") @db.Text
  idFormulario   String  @map("id_formulario") @db.VarChar(80)
  name           String? @map("name") @db.Text
  firNombre      String? @map("fir_nombre") @db.VarChar(255)
  firDni         String? @map("fir_dni") @db.VarChar(255)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("medidas_tdt")
}

model MonitoringCenter {

}

model MonitoringCenterMeasure {
  id           String   @id @default(uuid())
  name         String
  value        Float
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  userId       String?
  user         User?    @relation(fields: [userId], references: [id])
}
