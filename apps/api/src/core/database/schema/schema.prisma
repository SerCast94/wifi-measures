  provincia String                               @map("provincia") @db.VarChar(20)
  emisiones String                               @map("emisiones") @db.VarChar(1)
  ptoMedida String                               @map("pto_medida") @db.VarChar(3)
  nMedida   Int                                  @map("n_medida")
  fechaHora String                               @map("fecha_hora") @db.VarChar(50)
  azimut    Int

  // Canal C1
  c1Servici String?  @map("c1_servici") @db.VarChar(4)
  c1        Int?     @map("c1")
  c1Mhz     Decimal? @map("c1_mhz") @db.Decimal(20, 0)
  nivelC1   Decimal? @map("nivel_c1") @db.Decimal(20, 2)
  cNC1      Decimal? @map("c_n_c1") @db.Decimal(20, 2)
  cberC1    Decimal? @map("cber_c1") @db.Decimal(20, 6)
  vberC1    Decimal? @map("vber_c1") @db.Decimal(20, 8)
  merC1     Decimal? @map("mer_c1") @db.Decimal(20, 2)
  okC1      String?  @map("ok_c1") @db.VarChar(5)

  // Canal C2
  c2Servici String?  @map("c2_servici") @db.VarChar(4)
  c2        Int?     @map("c2")
