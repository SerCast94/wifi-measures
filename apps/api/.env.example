APP_NAME="Template TurboRepo API"
APP_VERSION="1.0.0"
APP_DESCRIPTION="Template TurboRepo API como plantilla para proyectos con Nestjs"
APP_PORT=3000
APP_HOST=localhost
# Environment (development, production, test)
APP_ENV="development"
# Logs levels (debug, log, verbose, warn, error, all) separated by comma
LOG_LEVEL=all
DELAY_RESPONSE=0 # Delay in seconds to simulate slow responses

# Cors origins allowed separated by comma
ALLOWED_ORIGINS="http://localhost:3000,http://localhost:3001"
# Cookie secret (random string min 32 characters)
COOKIE_SECRET="your-cookie-secret"

# CSRF Protection
CSRF_SECRET="your-csrf-secret"
CSRF_COOKIE_NAME="csrf-token"

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Session
SESSION_SECRET="your-session-secret"
SESSION_COOKIE_NAME="session-id"
SESSION_EXPIRES_IN_SECONDS=86400 # 1 day

# Database
DATABASE_URL="postgresql://<user>:<password>@localhost:5432/<database>?schema=public"