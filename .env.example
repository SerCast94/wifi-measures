# Example environment variables
# Variables para PostgreSQL
DB_HOST=template-postgres
DB_PORT=5432
DB_EXTERNAL_PORT=5432
DB_USERNAME=
DB_PASSWORD=
DB_NAME=
# Database URL para Prisma (postgresql://<username>:<password>@<host>:<port>/<dbname>?schema=public)
# ATENCIÓN: Las variables deben de coincidir con DB_HOST, DB_PORT, DB_USERNAME, DB_PASSWORD and DB_NAME
DATABASE_URL="postgresql://<username>:<password>@<host>:template-postgres/<dbname>?schema=public"

# Variables para Redis
REDIS_HOST=template-redis
REDIS_PORT=6379
REDIS_EXTERNAL_PORT=6379
REDIS_PASSWORD=

APP_NAME="Template API"
APP_VERSION="1.0.0"
APP_DESCRIPTION="Template API para la aplicación"
APP_PORT=3001
APP_EXTERNAL_PORT=3001
APP_HOST=0.0.0.0
# Environment (development, production, test)
APP_ENV="development"
# Logs levels (debug, log, verbose, warn, error, all) separated by comma
LOG_LEVEL=error
DELAY_RESPONSE=0 # Delay in seconds to simulate slow responses

# Cors origins allowed separated by comma
ALLOWED_ORIGINS="http://localhost:3001"
# Cookie secret (random string min 32 characters)
COOKIE_SECRET=<cookie_secret>

# CSRF Protection
CSRF_SECRET=<csrf_secret>
CSRF_COOKIE_NAME="csrf-token"

# Session
SESSION_SECRET=<session_secret>
SESSION_COOKIE_NAME="session-id"
SESSION_EXPIRES_IN_SECONDS=86400 # 1 day

# Variables para el Frontend
VITE_APP_NAME="Template Frontend"
VITE_STAGE="development" # development, staging, production
VITE_APP_VERSION="1.0.0"

# Variables para NetAlly Link-Live (API de auditorías Wi-Fi)
LINKLIVE_BASE_URL="https://link-live.com"
LINKLIVE_AUTH_URL="https://id.link-live.com"
LINKLIVE_USERNAME=
LINKLIVE_PASSWORD=
LINKLIVE_APP_ID=
LINKLIVE_ORG_ID=
